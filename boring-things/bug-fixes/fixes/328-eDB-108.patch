@@ -0,0 +1,29 @@
+import pytest
+
+from edb.core.engine import StorageEngine
+from edb.core.keyvalue import KeyValueStore
+
+
+@pytest.fixture
+def kv_store():
+    store = KeyValueStore(StorageEngine(":memory:"))
+    for key in ["user_1", "userX", "User_2", "users", "a%b", "abc"]:
+        store.set(key, 1)
+    return store
+
+
+@pytest.mark.parametrize(
+    ("prefix", "expected"),
+    [
+        ("user_", ["user_1"]),
+        ("User", ["User_2"]),
+        ("a%", ["a%b"]),
+        ("user", ["userX", "user_1", "users"]),
+    ],
+)
+def test_list_keys_matches_the_prefix_exactly(kv_store, prefix, expected):
+    assert sorted(kv_store.list_keys(prefix)) == expected
+
+
+def test_list_keys_without_a_prefix_returns_every_key(kv_store):
+    assert len(kv_store.list_keys()) == 6

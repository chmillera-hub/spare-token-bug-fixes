+            callback=_version_callback,
+            is_eager=True,
+            help="バージョンを表示する",
+        ),
+    ] = False,
+) -> None:
+    """拡張可能な AI Security Review プラットフォーム."""
 config_app = typer.Typer(help="設定の確認", no_args_is_help=True)

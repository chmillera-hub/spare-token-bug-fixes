+def is_calendar_date(text: str) -> bool:
+    """Whether text is YYYY-MM-DD in ASCII digits and names a date that exists."""
+    if not text.isascii() or not DATE_FORMAT.fullmatch(text):
+        return False
+    try:
+        date.fromisoformat(text)
+    except ValueError:
+        return False
+    return True
